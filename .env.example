# BlockMind AI Configuration
# 100% Free & Local - Zero Cloud / Zero API Keys Required

# Backend Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Ollama LLM Configuration (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9

# RAG & Embeddings Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
SIMILARITY_TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.35

# Storage Directories
DOCUMENTS_DIR=backend/data/documents
VECTORSTORE_DIR=backend/data/vectorstore
HISTORY_FILE=backend/data/history.json
BOOKMARKS_FILE=backend/data/bookmarks.json
ANALYTICS_FILE=backend/data/analytics.json
